# Copy to .env and fill in. Never commit .env.

# Postgres connection via the Supabase transaction pooler (port 6543).
# Password: Supabase dashboard -> Project Settings -> Database -> Reset database password
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# Used to verify user access tokens against Supabase Auth (anon key is public by design).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080

# Better Auth. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=<random-32-byte-secret>
BETTER_AUTH_URL=http://localhost:8787

# Optional Google OAuth. Leave both unset to disable the provider.
# Authorized redirect URI in Google Cloud:
#   http://localhost:8787/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional transactional email (password-reset). Leave RESEND_API_KEY unset to
# log the reset link to the console instead of sending. EMAIL_FROM must be a
# Resend-verified sender (their onboarding@resend.dev works for testing).
RESEND_API_KEY=
EMAIL_FROM=OutcomeFlow <onboarding@resend.dev>

# Cloudflare R2 object storage for file attachments. Create a bucket + an
# Account API token (Object Read & Write). Uploads are proxied through the API
# (POST /files/upload); downloads use presigned GET URLs. Leave unset to
# disable uploads (the endpoint returns 503).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=okroutcomeflow-uploads

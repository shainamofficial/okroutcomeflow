# Vite content-hashes asset filenames, so /assets/* files never change once
# built — cache them immutably for a year. Repeat visits (and the Cloudflare
# edge) serve them with zero revalidation. index.html itself keeps Pages'
# default short/revalidated policy so new deploys are picked up immediately.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Supabase — all client-safe (publishable) values only.
# Get these from: Supabase Dashboard → Settings → API

# Short alphanumeric project ref, e.g. "abcdxyz123"
VITE_SUPABASE_PROJECT_ID=""

# Full URL, e.g. "https://abcdxyz123.supabase.co"
VITE_SUPABASE_URL=""

# Long JWT starting with "eyJ...", safe to expose in client builds IF RLS is configured
VITE_SUPABASE_PUBLISHABLE_KEY=""

# OPTIONAL — strangler-migration switch. When set (e.g. "http://localhost:8787"),
# ported hooks call the owned API instead of Supabase directly. Leave unset for
# the pre-migration behavior.
# VITE_API_URL="http://localhost:8787"

# drizzle-orm declares optional peer deps on react-native sqlite drivers
# (@op-engineering/op-sqlite, expo-sqlite) which pull react-native -> react@19,
# conflicting with our react@18. We never install those drivers, so tolerate
# the unmet optional peers rather than fail the install. Keeps `npm ci` green
# in CI now that drizzle-orm is hoisted to the root (so better-auth's hoisted
# drizzle adapter can resolve it).
legacy-peer-deps=true
